# Copy to .env.local for local development. Never commit real values.

# Database (Turso / libSQL). Leave unset locally to use ./local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI layer (server only)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SETUP_MODEL=gemini-3.8-flash
LESSON_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-5-5

# Cost protection: lesson generations allowed per rolling 24 hours
LESSON_CAP_PER_LEARNER=25
LESSON_CAP_PER_IP=150
LESSON_CAP_GLOBAL=1000

# Public link used in reminder emails
APP_URL=http://localhost:3000
