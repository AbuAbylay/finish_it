# Copy to .env.local for local development. Never commit real values.

# Database (Turso / libSQL). Leave unset locally to use ./local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI layer (server only). With a key the real model calls run; without one the dev stub answers
# and every page shows a "Dev stub" banner.
ANTHROPIC_API_KEY=
SETUP_MODEL=claude-haiku-5-5
LESSON_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-5-5
SETUP_EFFORT=low
LESSON_EFFORT=medium

# Cost protection: model calls (lesson, setup, chat) allowed per rolling 24 hours
LESSON_CAP_PER_LEARNER=25
LESSON_CAP_PER_IP=600
LESSON_CAP_GLOBAL=1000
# New IDs allowed per IP per hour
ID_CAP_PER_IP_HOUR=300

# Public link used in reminder emails
APP_URL=http://localhost:3000
